# Copy to .env.local for local development. Configure real deployment values
# directly in Netlify environment variables; never commit credentials.
# The local server alone defaults to the documented password viagem-local.
# Production requires a private password of at least 12 characters.
DASHBOARD_PASSWORD=

# Flights: https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# Booking remains the selected hotel source. Its deployment binding is pending.
BOOKING_API_TOKEN=
BOOKING_AFFILIATE_ID=

# Optional notification channels
RESEND_API_KEY=
ALERT_FROM_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Opt in only after validating the source and checking the search allowance.
# At most two enabled monitors per round; manual searches consume extra calls.
ENABLE_SCHEDULED_COLLECTION=false
